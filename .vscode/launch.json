{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "V-NOC: run the extension, open the Python fixtures",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extension", "${workspaceFolder}/crates/vnoc-domain/tests/fixtures"],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
      "preLaunchTask": "build: everything"
    },
    {
      "name": "V-NOC: run the extension, no folder (open your own)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extension"],
      "outFiles": ["${workspaceFolder}/extension/dist/**/*.js"],
      "preLaunchTask": "build: everything"
    }
  ]
}
