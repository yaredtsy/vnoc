{
  "name": "vnoc",
  "displayName": "V-NOC",
  "description": "Browse code as a tree and a canvas, and attach docs that stay with the code when it is renamed or moved. Python and Bend.",
  "version": "0.3.1",
  "publisher": "vnoc",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "docs",
    "graph",
    "python",
    "bend",
    "documentation",
    "canvas",
    "call graph",
    "call hierarchy",
    "code visualization",
    "code navigation"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yaredtsy/vnoc"
  },
  "bugs": {
    "url": "https://github.com/yaredtsy/vnoc/issues"
  },
  "homepage": "https://github.com/yaredtsy/vnoc#readme",
  "qna": "https://discord.gg/J5nfPHqyBr",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:vnoc.canvas",
    "onWebviewPanel:vnoc.docs",
    "workspaceContains:.vnoc",
    "workspaceContains:**/*.bend",
    "workspaceContains:**/*.py"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode V-NOC ignores the executable paths set in workspace settings.",
      "restrictedConfigurations": [
        "vnoc.server.path",
        "vnoc.driver.path",
        "vnoc.drivers"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vnoc",
          "title": "V-NOC",
          "icon": "media/vnoc.svg"
        }
      ]
    },
    "views": {
      "vnoc": [
        {
          "type": "webview",
          "id": "vnoc.structure",
          "name": "Structure"
        },
        {
          "id": "vnoc.attention",
          "name": "Needs Attention",
          "when": "vnoc.hasAttention"
        }
      ]
    },
    "commands": [
      {
        "command": "vnoc.removeMissing",
        "title": "Remove…",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.removeAllMissing",
        "title": "Remove All Missing…",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.restoreRemoved",
        "title": "Restore Removed Doc…",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.emptyTrash",
        "title": "Empty Trash",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.relink",
        "title": "Relink…",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.attachMissingDocHere",
        "title": "Attach a Missing Doc Here…",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.writeId",
        "title": "Write ID",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.openMissingDocs",
        "title": "Open Docs",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.openProblem",
        "title": "Go There",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.openNotRead",
        "title": "Open File",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.openCanvas",
        "title": "Open Canvas",
        "category": "V-NOC",
        "icon": "$(graph)"
      },
      {
        "command": "vnoc.openTour",
        "title": "Open Tour…",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.openInCanvas",
        "title": "Open in Canvas",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.focus",
        "title": "Focus",
        "icon": "$(target)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.refreshStructure",
        "title": "Refresh Structure",
        "icon": "$(refresh)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.addDoc",
        "title": "Add Doc\u2026",
        "icon": "$(add)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.showDocs",
        "title": "Show Docs",
        "icon": "$(info)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.showCalls",
        "title": "Show Calls",
        "icon": "$(type-hierarchy)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.explore",
        "title": "Explore",
        "category": "V-NOC",
        "icon": "$(compass)"
      },
      {
        "command": "vnoc.goToCallSite",
        "title": "Go to Call Site…",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.closeContext",
        "title": "Close",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.closeOtherContexts",
        "title": "Close Others",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.focusBack",
        "title": "Focus Back",
        "icon": "$(arrow-left)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.focusClear",
        "title": "Clear Focus",
        "icon": "$(clear-all)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.goToCode",
        "title": "Go to Code",
        "category": "V-NOC",
        "icon": "$(go-to-file)"
      },
      {
        "command": "vnoc.open",
        "title": "Open",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.focusJump",
        "title": "Jump Back to This Focus",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.showLog",
        "title": "Show Log",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.reportIssue",
        "title": "Report Issue…",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.help",
        "title": "Help and Feedback…",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.installCli",
        "title": "Install `vnoc` Command in PATH",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.uninstallCli",
        "title": "Uninstall `vnoc` Command from PATH",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.setUpAgents",
        "title": "Set Up Coding Agents",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.revealInSidebar",
        "title": "Reveal in Sidebar",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.expand",
        "title": "Expand",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.collapse",
        "title": "Collapse",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.expandAll",
        "title": "Expand All Below",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.collapseAll",
        "title": "Collapse All",
        "category": "V-NOC",
        "icon": "$(collapse-all)"
      },
      {
        "command": "vnoc.showCodeInCard",
        "title": "Show Code in Card",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.hideCodeInCard",
        "title": "Hide Code in Card",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.editInCard",
        "title": "Edit in Card",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.fitView",
        "title": "Fit View",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.copyPath",
        "title": "Copy Path",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.clearSelection",
        "title": "Clear Selection",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.search",
        "title": "Search\u2026",
        "category": "V-NOC",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "vnoc.openMissingDocs",
          "when": "view == vnoc.attention && viewItem == missing",
          "group": "inline@1"
        },
        {
          "command": "vnoc.openMissingDocs",
          "when": "view == vnoc.attention && viewItem == missing",
          "group": "1_docs@1"
        },
        {
          "command": "vnoc.relink",
          "when": "view == vnoc.attention && viewItem == missing",
          "group": "2_fix@1"
        },
        {
          "command": "vnoc.removeMissing",
          "when": "view == vnoc.attention && viewItem == missing",
          "group": "2_fix@2"
        },
        {
          "command": "vnoc.writeId",
          "when": "view == vnoc.attention && viewItem == lostId",
          "group": "inline@1"
        },
        {
          "command": "vnoc.writeId",
          "when": "view == vnoc.attention && viewItem == lostId",
          "group": "2_fix@1"
        }
      ],
      "view/title": [
        {
          "command": "vnoc.openCanvas",
          "when": "view == vnoc.structure",
          "group": "navigation@1"
        },
        {
          "command": "vnoc.collapseAll",
          "when": "view == vnoc.structure",
          "group": "navigation@2"
        },
        {
          "command": "vnoc.restoreRemoved",
          "when": "view == vnoc.structure",
          "group": "1_more@3"
        },
        {
          "command": "vnoc.restoreRemoved",
          "when": "view == vnoc.attention",
          "group": "1_trash@1"
        },
        {
          "command": "vnoc.removeAllMissing",
          "when": "view == vnoc.attention && vnoc.hasMissing",
          "group": "1_trash@2"
        },
        {
          "command": "vnoc.search",
          "when": "view == vnoc.structure",
          "group": "1_more@2"
        },
        {
          "command": "vnoc.refreshStructure",
          "when": "view == vnoc.structure",
          "group": "1_more@1"
        },
        {
          "command": "vnoc.help",
          "when": "view == vnoc.structure",
          "group": "9_help@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vnoc.removeMissing",
          "when": "false"
        },
        {
          "command": "vnoc.relink",
          "when": "false"
        },
        {
          "command": "vnoc.attachMissingDocHere",
          "when": "false"
        },
        {
          "command": "vnoc.writeId",
          "when": "false"
        },
        {
          "command": "vnoc.openMissingDocs",
          "when": "false"
        },
        {
          "command": "vnoc.openProblem",
          "when": "false"
        },
        {
          "command": "vnoc.openNotRead",
          "when": "false"
        },
        {
          "command": "vnoc.focus",
          "when": "resourceExtname in vnoc.extensions"
        },
        {
          "command": "vnoc.addDoc",
          "when": "resourceExtname in vnoc.extensions"
        },
        {
          "command": "vnoc.showDocs",
          "when": "resourceExtname in vnoc.extensions"
        },
        {
          "command": "vnoc.focusBack",
          "when": "vnoc.focused"
        },
        {
          "command": "vnoc.focusClear",
          "when": "vnoc.focused"
        },
        {
          "command": "vnoc.goToCode",
          "when": "false"
        },
        {
          "command": "vnoc.open",
          "when": "false"
        },
        {
          "command": "vnoc.focusJump",
          "when": "false"
        },
        {
          "command": "vnoc.revealInSidebar",
          "when": "resourceExtname in vnoc.extensions"
        },
        {
          "command": "vnoc.revealInExplorer",
          "when": "resourceExtname in vnoc.extensions"
        },
        {
          "command": "vnoc.expand",
          "when": "false"
        },
        {
          "command": "vnoc.collapse",
          "when": "false"
        },
        {
          "command": "vnoc.expandAll",
          "when": "false"
        },
        {
          "command": "vnoc.collapseAll",
          "when": "vnoc.canvasOpen"
        },
        {
          "command": "vnoc.showCodeInCard",
          "when": "false"
        },
        {
          "command": "vnoc.hideCodeInCard",
          "when": "false"
        },
        {
          "command": "vnoc.editInCard",
          "when": "false"
        },
        {
          "command": "vnoc.fitView",
          "when": "vnoc.canvasOpen"
        },
        {
          "command": "vnoc.copyPath",
          "when": "resourceExtname in vnoc.extensions"
        },
        {
          "command": "vnoc.clearSelection",
          "when": "vnoc.hasSelection"
        },
        {
          "command": "vnoc.showCalls",
          "when": "false"
        },
        {
          "command": "vnoc.openInCanvas",
          "when": "resourceExtname in vnoc.extensions"
        },
        {
          "command": "vnoc.explore",
          "when": "false"
        },
        {
          "command": "vnoc.goToCallSite",
          "when": "false"
        },
        {
          "command": "vnoc.closeContext",
          "when": "vnoc.activeIsExplore"
        },
        {
          "command": "vnoc.closeOtherContexts",
          "when": "vnoc.activeIsExplore"
        }
      ],
      "editor/context": [
        {
          "submenu": "vnoc.editorMenu",
          "group": "navigation@9",
          "when": "resourceExtname in vnoc.extensions"
        }
      ],
      "vnoc.editorMenu": [
        {
          "command": "vnoc.revealInSidebar",
          "group": "1_nav@1"
        },
        {
          "command": "vnoc.openInCanvas",
          "group": "1_nav@2"
        },
        {
          "command": "vnoc.focus",
          "group": "1_nav@3"
        },
        {
          "command": "vnoc.showCalls",
          "when": "resourceExtname in vnoc.callTreeExtensions",
          "group": "3_calls@1"
        },
        {
          "command": "vnoc.showDocs",
          "group": "5_docs@1"
        },
        {
          "command": "vnoc.addDoc",
          "group": "5_docs@2"
        },
        {
          "command": "vnoc.attachMissingDocHere",
          "when": "vnoc.hasMissing",
          "group": "5_docs@3"
        },
        {
          "command": "vnoc.writeId",
          "group": "5_docs@4"
        }
      ],
      "editor/title": [
        {
          "command": "vnoc.showDocs",
          "group": "navigation",
          "when": "resourceExtname in vnoc.extensions"
        }
      ],
      "webview/context": [
        {
          "command": "vnoc.focus",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && !isFocusRoot",
          "group": "1_nav@1"
        },
        {
          "command": "vnoc.focusBack",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && isFocusRoot",
          "group": "1_nav@1"
        },
        {
          "command": "vnoc.openInCanvas",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && surface == sidebar",
          "group": "1_nav@2"
        },
        {
          "command": "vnoc.revealInSidebar",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && surface == canvas",
          "group": "1_nav@2"
        },
        {
          "command": "vnoc.expand",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && hasChildren && !open",
          "group": "2_open@1"
        },
        {
          "command": "vnoc.collapse",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && hasChildren && open",
          "group": "2_open@1"
        },
        {
          "command": "vnoc.expandAll",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && hasChildren && kind != function",
          "group": "2_open@2"
        },
        {
          "command": "vnoc.showCalls",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && (kind == function || kind == class) && fileExtname in vnoc.callTreeExtensions",
          "group": "3_calls@1"
        },
        {
          "command": "vnoc.goToCode",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && kind != folder",
          "group": "4_code@1"
        },
        {
          "command": "vnoc.showCodeInCard",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && surface == canvas && hasCode && !codeOpen",
          "group": "4_code@2"
        },
        {
          "command": "vnoc.hideCodeInCard",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && surface == canvas && codeOpen",
          "group": "4_code@2"
        },
        {
          "command": "vnoc.editInCard",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && surface == canvas && hasCode && (kind == function || kind == class)",
          "group": "4_code@3"
        },
        {
          "command": "vnoc.revealInExplorer",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && (kind == file || kind == folder)",
          "group": "4_code@3"
        },
        {
          "command": "vnoc.showDocs",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node",
          "group": "5_docs@1"
        },
        {
          "command": "vnoc.addDoc",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && nodeKey != '/'",
          "group": "5_docs@2"
        },
        {
          "command": "vnoc.attachMissingDocHere",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && vnoc.hasMissing && nodeKey != '/'",
          "group": "5_docs@3"
        },
        {
          "command": "vnoc.writeId",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node && byName",
          "group": "5_docs@4"
        },
        {
          "command": "vnoc.copyPath",
          "when": "webviewId =~ /^vnoc\\.(canvas|structure)$/ && webviewSection == 'node' && role == node",
          "group": "9_copy@1"
        },
        {
          "command": "vnoc.explore",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && role == call && surface == canvas && calleeKnown",
          "group": "1_nav@1"
        },
        {
          "command": "vnoc.expand",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && role == call && surface == canvas && hasChildren && !open",
          "group": "2_open@1"
        },
        {
          "command": "vnoc.collapse",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && role == call && surface == canvas && hasChildren && open",
          "group": "2_open@1"
        },
        {
          "command": "vnoc.goToCallSite",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && role == call && surface == canvas && sites > 0",
          "group": "4_code@1"
        },
        {
          "command": "vnoc.goToCode",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && role == call && surface == canvas && calleeKnown",
          "group": "4_code@2"
        },
        {
          "command": "vnoc.showCodeInCard",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && role == call && surface == canvas && calleeKnown && hasCode && !codeOpen",
          "group": "4_code@3"
        },
        {
          "command": "vnoc.hideCodeInCard",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && role == call && surface == canvas && calleeKnown && codeOpen",
          "group": "4_code@3"
        },
        {
          "command": "vnoc.editInCard",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && role == call && surface == canvas && calleeKnown && hasCode",
          "group": "4_code@4"
        },
        {
          "command": "vnoc.showDocs",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && role == call && surface == canvas && calleeKnown",
          "group": "5_docs@1"
        },
        {
          "command": "vnoc.addDoc",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && role == call && surface == canvas && calleeKnown",
          "group": "5_docs@2"
        },
        {
          "command": "vnoc.copyPath",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && role == call && surface == canvas && calleeKnown",
          "group": "9_copy@1"
        },
        {
          "command": "vnoc.fitView",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'pane'",
          "group": "1_view@1"
        },
        {
          "command": "vnoc.collapseAll",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'pane'",
          "group": "1_view@2"
        },
        {
          "command": "vnoc.focusBack",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'pane' && vnoc.focused",
          "group": "2_session@1"
        },
        {
          "command": "vnoc.focusClear",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'pane' && vnoc.focused",
          "group": "2_session@2"
        },
        {
          "command": "vnoc.clearSelection",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'pane' && vnoc.hasSelection",
          "group": "2_session@3"
        },
        {
          "command": "vnoc.closeContext",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'pane' && vnoc.activeIsExplore",
          "group": "3_close@1"
        },
        {
          "command": "vnoc.collapseAll",
          "when": "webviewId == 'vnoc.structure' && webviewSection == 'pane' && surface == sidebar",
          "group": "1_view@1"
        },
        {
          "command": "vnoc.focusClear",
          "when": "webviewId == 'vnoc.structure' && webviewSection == 'pane' && surface == sidebar && vnoc.focused",
          "group": "2_session@1"
        },
        {
          "command": "vnoc.refreshStructure",
          "when": "webviewId == 'vnoc.structure' && webviewSection == 'pane' && surface == sidebar",
          "group": "3_data@1"
        },
        {
          "command": "vnoc.closeContext",
          "when": "webviewId == 'vnoc.structure' && webviewSection == 'context' && contextKind == explore",
          "group": "1_close@1"
        },
        {
          "command": "vnoc.closeOtherContexts",
          "when": "webviewId == 'vnoc.structure' && webviewSection == 'context'",
          "group": "1_close@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "vnoc.explorerMenu",
          "group": "7_modification@9",
          "when": "explorerResourceIsFolder || resourceExtname in vnoc.extensions"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "vnoc.editorMenu",
          "group": "3_open@9",
          "when": "resourceExtname in vnoc.extensions"
        }
      ],
      "vnoc.explorerMenu": [
        {
          "command": "vnoc.revealInSidebar",
          "group": "1_nav@1"
        },
        {
          "command": "vnoc.openInCanvas",
          "group": "1_nav@2"
        },
        {
          "command": "vnoc.focus",
          "group": "1_nav@3"
        },
        {
          "command": "vnoc.showDocs",
          "group": "5_docs@1"
        },
        {
          "command": "vnoc.addDoc",
          "group": "5_docs@2"
        }
      ]
    },
    "configuration": {
      "title": "V-NOC",
      "properties": {
        "vnoc.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the vnoc core binary. Empty = the build folder of this repository (development). Ignored from workspace settings in Restricted Mode."
        },
        "vnoc.drivers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Paths to the language driver binaries (vnoc-driver-*). Empty = every driver found by itself: the ones installed with V-NOC, or in development the ones built in drivers/*/target/debug. Ignored from workspace settings in Restricted Mode."
        },
        "vnoc.driver.path": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Deprecated: use vnoc.drivers.",
          "description": "Deprecated: use vnoc.drivers. Path to one driver binary, read as a list of one. Ignored from workspace settings in Restricted Mode."
        },
        "vnoc.sidebar.click": {
          "type": "string",
          "enum": [
            "auto",
            "code",
            "canvas"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Show the node on the canvas while the canvas is open; otherwise open the code.",
            "Always open the code (the behaviour before 0.1).",
            "Always show the node on the canvas, opening the canvas if it is closed."
          ],
          "description": "What a click on a node in the V-NOC sidebar does."
        }
      }
    },
    "submenus": [
      {
        "id": "vnoc.editorMenu",
        "label": "V-NOC"
      },
      {
        "id": "vnoc.explorerMenu",
        "label": "V-NOC"
      }
    ],
    "keybindings": [
      {
        "command": "vnoc.search",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc --noEmit -p .",
    "test": "esbuild src/test/runTest.ts src/test/suite/index.ts src/test/suite/skeleton.test.ts src/test/suite/session.test.ts src/test/suite/sidebar.test.ts src/test/suite/attention.test.ts src/test/suite/refactor.test.ts src/test/suite/calls.test.ts src/test/suite/edit.test.ts src/test/suite/bar.test.ts src/test/suite/search.test.ts src/test/suite/cli.test.ts src/test/suite/bend.test.ts --bundle --platform=node --format=cjs --external:vscode --external:mocha --external:@vscode/test-electron --outbase=src --outdir=out && node out/test/runTest.js",
    "unit": "node --test --experimental-strip-types ../shared/tree.test.ts ../shared/session.test.ts src/menus.test.ts src/report.test.ts src/dirtyFiles.test.ts src/saveDraft.test.ts src/sidebarSlot.test.ts src/cliInstall.test.ts src/agentsJson.test.ts src/tours.test.ts"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "@vnoc/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.146.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "mocha": "^10.0.0",
    "typescript": "^5.6.0"
  }
}
