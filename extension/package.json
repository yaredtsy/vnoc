{
  "name": "vnoc",
  "displayName": "V-NOC",
  "description": "Browse code as a graph and attach docs to it (walking skeleton).",
  "version": "0.0.1",
  "publisher": "vnoc",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:vnoc.canvas",
    "onWebviewPanel:vnoc.docs"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode V-NOC ignores the executable paths set in workspace settings.",
      "restrictedConfigurations": [
        "vnoc.server.path",
        "vnoc.driver.path"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vnoc",
          "title": "V-NOC",
          "icon": "media/vnoc.svg"
        }
      ]
    },
    "views": {
      "vnoc": [
        {
          "id": "vnoc.focusStack",
          "name": "Focus",
          "when": "vnoc.focused"
        },
        {
          "id": "vnoc.structure",
          "name": "Structure"
        }
      ]
    },
    "commands": [
      {
        "command": "vnoc.openCanvas",
        "title": "Open Canvas",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.focus",
        "title": "Focus",
        "icon": "$(target)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.refreshStructure",
        "title": "Refresh Structure",
        "icon": "$(refresh)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.addDoc",
        "title": "Add Doc\u2026",
        "icon": "$(add)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.showOnCanvas",
        "title": "Show on Canvas",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.showDocs",
        "title": "Show Docs",
        "icon": "$(info)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.focusBack",
        "title": "Focus Back",
        "icon": "$(arrow-left)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.focusClear",
        "title": "Clear Focus",
        "icon": "$(clear-all)",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.goToCode",
        "title": "Go to Code",
        "category": "V-NOC",
        "icon": "$(go-to-file)"
      },
      {
        "command": "vnoc.open",
        "title": "Open",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.focusJump",
        "title": "Jump Back to This Focus",
        "category": "V-NOC"
      },
      {
        "command": "vnoc.focusDrop",
        "title": "Drop This Focus Step",
        "category": "V-NOC",
        "icon": "$(close)"
      },
      {
        "command": "vnoc.showLog",
        "title": "Show Log",
        "category": "V-NOC"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "vnoc.focus",
          "when": "view == vnoc.structure && viewItem =~ /\\bnode\\b/",
          "group": "inline@1"
        },
        {
          "command": "vnoc.goToCode",
          "when": "view == vnoc.structure && viewItem =~ /\\b(file|class|function)\\b/",
          "group": "inline@2"
        },
        {
          "command": "vnoc.addDoc",
          "when": "view == vnoc.structure && viewItem =~ /\\bnode\\b/",
          "group": "inline@3"
        },
        {
          "command": "vnoc.focusBack",
          "when": "view == vnoc.structure && viewItem == focusBar",
          "group": "inline@1"
        },
        {
          "command": "vnoc.focusClear",
          "when": "view == vnoc.structure && viewItem == focusBar",
          "group": "inline@2"
        },
        {
          "command": "vnoc.focusDrop",
          "when": "view == vnoc.focusStack && viewItem == step",
          "group": "inline"
        },
        {
          "command": "vnoc.focus",
          "when": "view == vnoc.structure && viewItem =~ /\\bnode\\b/",
          "group": "1_vnoc@1"
        },
        {
          "command": "vnoc.showOnCanvas",
          "when": "view == vnoc.structure && viewItem =~ /\\bnode\\b/",
          "group": "1_vnoc@2"
        },
        {
          "command": "vnoc.openCanvas",
          "when": "view == vnoc.structure && viewItem =~ /\\bnode\\b/",
          "group": "1_vnoc@3"
        },
        {
          "command": "vnoc.addDoc",
          "when": "view == vnoc.structure && viewItem =~ /\\bnode\\b/",
          "group": "2_vnoc@1"
        },
        {
          "command": "vnoc.showDocs",
          "when": "view == vnoc.structure && viewItem =~ /\\bnode\\b/",
          "group": "2_vnoc@2"
        },
        {
          "command": "vnoc.goToCode",
          "when": "view == vnoc.structure && viewItem =~ /\\b(file|class|function)\\b/",
          "group": "3_code@1"
        }
      ],
      "view/title": [
        {
          "command": "vnoc.refreshStructure",
          "when": "view == vnoc.structure",
          "group": "navigation"
        },
        {
          "command": "vnoc.focusBack",
          "when": "view == vnoc.focusStack",
          "group": "navigation@1"
        },
        {
          "command": "vnoc.focusClear",
          "when": "view == vnoc.focusStack",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "vnoc.focus",
          "when": "editorLangId == python"
        },
        {
          "command": "vnoc.addDoc",
          "when": "editorLangId == python"
        },
        {
          "command": "vnoc.showOnCanvas",
          "when": "editorLangId == python"
        },
        {
          "command": "vnoc.showDocs",
          "when": "editorLangId == python"
        },
        {
          "command": "vnoc.focusBack",
          "when": "vnoc.focused"
        },
        {
          "command": "vnoc.focusClear",
          "when": "vnoc.focused"
        },
        {
          "command": "vnoc.goToCode",
          "when": "false"
        },
        {
          "command": "vnoc.open",
          "when": "false"
        },
        {
          "command": "vnoc.focusJump",
          "when": "false"
        },
        {
          "command": "vnoc.focusDrop",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "vnoc.editorMenu",
          "group": "navigation@9",
          "when": "resourceLangId == python"
        }
      ],
      "vnoc.editorMenu": [
        {
          "command": "vnoc.focus",
          "group": "1_show@1"
        },
        {
          "command": "vnoc.showOnCanvas",
          "group": "1_show@2"
        },
        {
          "command": "vnoc.openCanvas",
          "group": "1_show@3"
        },
        {
          "command": "vnoc.showDocs",
          "group": "2_docs@1"
        },
        {
          "command": "vnoc.addDoc",
          "group": "2_docs@2"
        }
      ],
      "editor/title": [
        {
          "command": "vnoc.showDocs",
          "group": "navigation",
          "when": "resourceLangId == python"
        }
      ],
      "webview/context": [
        {
          "command": "vnoc.addDoc",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && (kind == function || kind == class || kind == file || kind == folder)",
          "group": "1_docs@1"
        },
        {
          "command": "vnoc.showDocs",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node'",
          "group": "1_docs@2"
        },
        {
          "command": "vnoc.focus",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node'",
          "group": "2_canvas@1"
        },
        {
          "command": "vnoc.goToCode",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node'",
          "group": "3_code@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "vnoc.editorMenu",
          "group": "7_modification@9",
          "when": "resourceLangId == python || explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "V-NOC",
      "properties": {
        "vnoc.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the vnoc core binary. Empty = the build folder of this repository (development). Ignored from workspace settings in Restricted Mode."
        },
        "vnoc.driver.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Python driver binary. Empty = the build folder of this repository (development). Ignored from workspace settings in Restricted Mode."
        },
        "vnoc.sidebar.click": {
          "type": "string",
          "enum": [
            "auto",
            "code",
            "canvas"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Show the node on the canvas while the canvas is open; otherwise open the code.",
            "Always open the code (the behaviour before 0.1).",
            "Always show the node on the canvas, opening the canvas if it is closed."
          ],
          "description": "What a click on a node in the V-NOC sidebar does."
        }
      }
    },
    "submenus": [
      {
        "id": "vnoc.editorMenu",
        "label": "V-NOC"
      }
    ],
    "viewsWelcome": [
      {
        "view": "vnoc.structure",
        "when": "workspaceFolderCount == 0",
        "contents": "Open a folder to see its code.\n[Open Folder](command:workbench.action.files.openFolder)"
      },
      {
        "view": "vnoc.structure",
        "when": "workspaceFolderCount != 0 && vnoc.sidebarState == empty",
        "contents": "No Python files here yet."
      },
      {
        "view": "vnoc.structure",
        "when": "workspaceFolderCount != 0 && vnoc.sidebarState == error",
        "contents": "V-NOC could not read this project.\n[Try Again](command:vnoc.refreshStructure)\n[Show Log](command:vnoc.showLog)"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc --noEmit -p .",
    "test": "esbuild src/test/runTest.ts src/test/suite/index.ts src/test/suite/skeleton.test.ts src/test/suite/session.test.ts src/test/suite/sidebar.test.ts --bundle --platform=node --format=cjs --external:vscode --external:mocha --external:@vscode/test-electron --outbase=src --outdir=out && node out/test/runTest.js",
    "unit": "node --test --experimental-strip-types ../shared/tree.test.ts ../shared/session.test.ts"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "@vnoc/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.0",
    "mocha": "^10.0.0",
    "typescript": "^5.6.0"
  }
}
