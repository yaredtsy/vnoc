{
  "name": "vnoc",
  "displayName": "V-NOC",
  "description": "Browse code as a graph and attach docs to it (walking skeleton).",
  "version": "0.0.1",
  "publisher": "vnoc",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:vnoc.canvas",
    "onWebviewPanel:vnoc.docs"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode V-NOC ignores the executable paths set in workspace settings.",
      "restrictedConfigurations": [
        "vnoc.server.path",
        "vnoc.driver.path"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vnoc",
          "title": "V-NOC",
          "icon": "media/vnoc.svg"
        }
      ]
    },
    "views": {
      "vnoc": [
        {
          "id": "vnoc.structure",
          "name": "Structure"
        }
      ]
    },
    "commands": [
      {
        "command": "vnoc.openCanvas",
        "title": "V-NOC: Open canvas"
      },
      {
        "command": "vnoc.focus",
        "title": "V-NOC: Focus on canvas",
        "icon": "$(target)"
      },
      {
        "command": "vnoc.refreshStructure",
        "title": "V-NOC: Refresh structure",
        "icon": "$(refresh)"
      },
      {
        "command": "vnoc.addDoc",
        "title": "V-NOC: Add doc",
        "icon": "$(add)"
      },
      {
        "command": "vnoc.showOnCanvas",
        "title": "V-NOC: Show on canvas"
      },
      {
        "command": "vnoc.showDocs",
        "title": "V-NOC: Show docs",
        "icon": "$(info)"
      },
      {
        "command": "vnoc.focusBack",
        "title": "V-NOC: Focus back",
        "icon": "$(arrow-left)"
      },
      {
        "command": "vnoc.focusClear",
        "title": "V-NOC: Clear focus",
        "icon": "$(clear-all)"
      },
      {
        "command": "vnoc.goToCode",
        "title": "V-NOC: Go to code"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "vnoc.focus",
          "when": "view == vnoc.structure",
          "group": "inline"
        },
        {
          "command": "vnoc.addDoc",
          "when": "view == vnoc.structure && (viewItem == function || viewItem == class || viewItem == file || viewItem == folder)",
          "group": "inline"
        },
        {
          "command": "vnoc.focus",
          "when": "view == vnoc.structure",
          "group": "1_vnoc@1"
        },
        {
          "command": "vnoc.addDoc",
          "when": "view == vnoc.structure && (viewItem == function || viewItem == class || viewItem == file || viewItem == folder)",
          "group": "1_vnoc@2"
        },
        {
          "command": "vnoc.showDocs",
          "when": "view == vnoc.structure",
          "group": "1_vnoc@3"
        },
        {
          "command": "vnoc.goToCode",
          "when": "view == vnoc.structure",
          "group": "2_code@1"
        }
      ],
      "view/title": [
        {
          "command": "vnoc.refreshStructure",
          "when": "view == vnoc.structure",
          "group": "navigation"
        },
        {
          "command": "vnoc.focusBack",
          "when": "view == vnoc.structure && vnoc.focused",
          "group": "navigation@1"
        },
        {
          "command": "vnoc.focusClear",
          "when": "view == vnoc.structure && vnoc.focused",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "vnoc.focus",
          "when": "editorLangId == python"
        },
        {
          "command": "vnoc.addDoc",
          "when": "editorLangId == python"
        },
        {
          "command": "vnoc.showOnCanvas",
          "when": "editorLangId == python"
        },
        {
          "command": "vnoc.showDocs",
          "when": "editorLangId == python"
        },
        {
          "command": "vnoc.focusBack",
          "when": "vnoc.focused"
        },
        {
          "command": "vnoc.focusClear",
          "when": "vnoc.focused"
        },
        {
          "command": "vnoc.goToCode",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "vnoc.editorMenu",
          "group": "navigation@9",
          "when": "resourceLangId == python"
        }
      ],
      "vnoc.editorMenu": [
        {
          "command": "vnoc.openCanvas",
          "group": "1_canvas@0"
        },
        {
          "command": "vnoc.showOnCanvas",
          "group": "1_canvas@1"
        },
        {
          "command": "vnoc.focus",
          "group": "1_canvas@2"
        },
        {
          "command": "vnoc.showDocs",
          "group": "2_docs@1"
        },
        {
          "command": "vnoc.addDoc",
          "group": "2_docs@2"
        }
      ],
      "editor/title": [
        {
          "command": "vnoc.showDocs",
          "group": "navigation",
          "when": "resourceLangId == python"
        }
      ],
      "webview/context": [
        {
          "command": "vnoc.addDoc",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node' && (kind == function || kind == class || kind == file || kind == folder)",
          "group": "1_docs@1"
        },
        {
          "command": "vnoc.showDocs",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node'",
          "group": "1_docs@2"
        },
        {
          "command": "vnoc.focus",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node'",
          "group": "2_canvas@1"
        },
        {
          "command": "vnoc.goToCode",
          "when": "webviewId == 'vnoc.canvas' && webviewSection == 'node'",
          "group": "3_code@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "vnoc.editorMenu",
          "group": "7_modification@9",
          "when": "resourceLangId == python || explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "V-NOC",
      "properties": {
        "vnoc.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the vnoc core binary. Empty = the build folder of this repository (development). Ignored from workspace settings in Restricted Mode."
        },
        "vnoc.driver.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Python driver binary. Empty = the build folder of this repository (development). Ignored from workspace settings in Restricted Mode."
        }
      }
    },
    "submenus": [
      {
        "id": "vnoc.editorMenu",
        "label": "V-NOC"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsc -p . --noEmit false --outDir out && node out/test/runTest.js",
    "unit": "node --test --experimental-strip-types src/nodeAt.test.ts"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "@vnoc/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.0",
    "mocha": "^10.0.0",
    "typescript": "^5.6.0"
  }
}
